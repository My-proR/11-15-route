# ===== RoutePilot — placeholders only. Copy to services/api/.env (API) and apps/web/.env (web). NEVER commit real values. =====

# --- Backend (services/api/.env) ---
APP_ENV=development                      # development | staging | production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/routepilot   # Supabase: use the pooled/direct connection string of the OWNER role
MIGRATION_DATABASE_URL=                  # optional: direct (non-pooled) URL for `alembic upgrade head`
REDIS_URL=                               # optional; required only when running more than one API instance
CORS_ORIGINS=http://localhost:5173       # comma separated, exact origins; wildcard is rejected in production

# Supabase Auth (server side). Use ONE of the two JWT options.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_ISSUER=                     # optional: expected token issuer; defaults to SUPABASE_URL + /auth/v1 (production requires one of the two)
SUPABASE_JWT_SECRET=                     # legacy HS256 projects
SUPABASE_JWKS_URL=                       # https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json (asymmetric keys)
SUPABASE_SERVICE_ROLE_KEY=               # SERVER ONLY (invites). Never put this in VITE_* / EXPO_PUBLIC_* variables.

# Feature switches — authoritative, default OFF. Both layers + the organization setting must be ON.
GPS_SOS_FEATURE_ENABLED=false
LIVE_TRACKING_FEATURE_ENABLED=false
LIVE_TRACKING_MIN_INTERVAL_SECONDS=10

# Billing (printed on invoices)
BILLING_SELLER_NAME=
BILLING_SELLER_GSTIN=
BILLING_PAYMENT_INSTRUCTIONS=            # e.g. UPI id / bank details

# Behind Render/Vercel/any proxy: trust it so rate limits see the real client address (the Dockerfile already does)
FORWARDED_ALLOW_IPS=*
RATE_LIMIT_PER_MINUTE=240                # per client address; raise (e.g. 1200) when many users share one office address

# Routing (OpenStreetMap-based OSRM). Without it, plans are marked "provisional" and cannot be sent/confirmed.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=                           # e.g. https://your-osrm.example.com

# Realtime / ops
REALTIME_TICKET_SECRET=                  # >= 32 random chars (openssl rand -hex 32)
METRICS_TOKEN=                           # empty disables /metrics

# Notifications (all optional; nothing is sent unless NOTIFICATIONS_SEND_REAL=true)
NOTIFICATIONS_SEND_REAL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Web (apps/web/.env) — public values only; these end up in the browser bundle ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=                  # the public anon/publishable key — NOT the service-role key

# --- Mobile (apps/mobile/.env) — public values only ---
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- docker-compose only ---
POSTGRES_PASSWORD=change-me-local-only
